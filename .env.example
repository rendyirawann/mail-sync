# Nama & deskripsi aplikasi (dipakai di judul, meta SEO, email).
APP_NAME="Mail Sync"
APP_DESCRIPTION="Mail Sync — aplikasi web untuk menyinkronkan, mengelola, dan memantau email antar akun dalam satu panel admin yang aman."
# Production: APP_ENV=production
APP_ENV=local
# Isi dengan: php artisan key:generate
APP_KEY=
# Production: WAJIB false
APP_DEBUG=true
# Harus sama persis dengan host yang dibuka di browser (localhost vs 127.0.0.1) agar tidak 419.
APP_URL=http://127.0.0.1:8881
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: LOG_LEVEL=error
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mail_sync
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_COOKIE=mail_sync_session
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set to true once the app is served over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=mail_sync_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (websocket). Generate nilai acak per project — jangan salin dari project lain.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# SEO & brand
# ---------------------------------------------------------------------------
SEO_KEYWORDS="mail sync, sinkronisasi email, email, imap, manajemen email, panel admin, dashboard email"
# Kosongkan untuk memakai public/og-image.png
SEO_OG_IMAGE=
BRAND_PRIMARY_COLOR="#1D4ED8"
BRAND_SECONDARY_COLOR="#0E7490"

# ---------------------------------------------------------------------------
# Anti-spam (Cloudflare Turnstile) — form tetap jalan bila false / key kosong
# ---------------------------------------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Content Security Policy. Permissive by default so the theme's inline scripts
# and CDN plugins keep working. Add origins (space separated) if you integrate
# a third-party widget; set CSP_ENABLED=false only as a last resort.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_UPGRADE_INSECURE=false
SECURITY_CSP_EXTRA_HOSTS=

# Production (HTTPS): true. Turn on only once HTTPS is confirmed working in production - browsers
# remember this header for a year.
SECURITY_HSTS=false

# Rejects URLs carrying obvious SQLi / traversal / XSS signatures.
SECURITY_BLOCK_SUSPICIOUS=true

# Requests per minute.
RATE_LIMIT_WEB=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_WRITE=60
RATE_LIMIT_API=60

# CORS applies ONLY to api/* and broadcasting/auth - never to pages or assets.
# Comma separated; defaults to APP_URL when empty.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=

# Set to your proxy IPs (or "*") ONLY when running behind nginx/Cloudflare.
# Leave empty otherwise, or clients can spoof their IP via X-Forwarded-For.
TRUSTED_PROXIES=

# Peran otomatis untuk user baru dari login sosial (kosong = tanpa peran). "Superadmin" selalu ditolak.
PERMISSION_DEFAULT_ROLE=

# Permissions-Policy kustom (opsional). Default hanya mematikan payment/usb/serial/dll.
# SECURITY_PERMISSIONS_POLICY="payment=(), usb=()"
